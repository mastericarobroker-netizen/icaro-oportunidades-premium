ata-kid=\"582\"></svg>\n    </span>\n  </a>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"584\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"585\"></script>\n<script data-kid=\"586\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Soft reveals\n  gsap.utils.toArray('[data-reveal]').forEach(function (el) {\n    gsap.fromTo(el,\n      { y: 30, autoAlpha: 0 },\n      {\n        y: 0, autoAlpha: 1, duration: 0.9, ease: 'power3.out',\n        clearProps: 'transform,opacity,visibility',\n        scrollTrigger: { trigger: el, start: 'top 88%', once: true }\n      }\n    );\n  });\n\n  // Reveal wrappers (cards/rows with their own CSS hover transforms)\n  gsap.utils.toArray('[data-reveal-wrap]').forEach(function (el, i) {\n    gsap.fromTo(el,\n      { y: 34, autoAlpha: 0 },\n      {\n        y: 0, autoAlpha: 1, duration: 0.9, delay: (i % 4) * 0.08, ease: 'power3.out',\n        clearProps: 'transform,opacity,visibility',\n        scrollTrigger: { trigger: el, start: 'top 90%', once: true }\n      }\n    );\n  });\n\n  // Gold eyebrow lines grow\n  gsap.utils.toArray('.grow-line').forEach(function (el) {\n    gsap.fromTo(el, { scaleX: 0 }, {\n      scaleX: 1, duration: 1.1, ease: 'power3.out',\n      scrollTrigger: { trigger: el, start: 'top 92%', once: true }\n    });\n  });\n\n  // Animated counters\n  gsap.utils.toArray('.counter').forEach(function (el) {\n    var target = parseInt(el.getAttribute('data-target'), 10);\n    var obj = { v: 0 };\n    gsap.to(obj, {\n      v: target, duration: 1.8, ease: 'power2.out',\n      onUpdate: function () { el.textContent = Math.round(obj.v); },\n      scrollTrigger: { trigger: el, start: 'top 92%', once: true }\n    });\n  });\n\n  // Subtle image parallax\n  gsap.utils.toArray('[data-parallax]').forEach(function (img) {\n    gsap.set(img, { scale: 1.12 });\n    gsap.fromTo(img, { yPercent: -5 }, {\n      yPercent: 5, ease: 'none',\n      scrollTrigger: { trigger: img.closest('div'), start: 'top bottom', end: 'bottom top', scrub: true }\n    });\n  });\n\n  // SP map draw\n  (function () {\n    var sp = document.getElementById('spPath');\n    var vale = document.getElementById('valePath');\n    var marker = document.getElementById('sjcMarker');\n    if (!sp) return;\n    var len = sp.getTotalLength();\n    gsap.set(sp, { strokeDasharray: len, strokeDashoffset: len, fillOpacity: 0 });\n    gsap.set(vale, { autoAlpha: 0 });\n    gsap.set(marker, { autoAlpha: 0, transformOrigin: '298px 248px', scale: 0.6 });\n    var tl = gsap.timeline({ scrollTrigger: { trigger: sp, start: 'top 80%', once: true } });\n    tl.to(sp, { strokeDashoffset: 0, duration: 1.8, ease: 'power2.inOut' })\n      .to(sp, { fillOpacity: 1, duration: 0.7 }, '-=0.5')\n      .to(vale, { autoAlpha: 1, duration: 0.8 }, '-=0.3')\n      .to(marker, { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'back.out(2)' }, '-=0.3');\n  })();\n</script>",
