      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap');\n\n  .font-display { font-family: 'Fraunces', 'Georgia', serif; }\n  .font-body { font-family: 'Inter', system-ui, sans-serif; }\n\n  .hero-texture {\n    background-image:\n      radial-gradient(ellipse 60% 45% at 72% 30%, rgba(180,148,82,0.07), transparent 70%),\n      linear-gradient(to right, rgba(12,11,9,0.028) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(12,11,9,0.028) 1px, transparent 1px);\n    background-size: 100% 100%, 96px 96px, 96px 96px;\n  }\n\n  @keyframes marquee-x {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n  .marquee-track { animation: marquee-x 38s linear infinite; }\n\n  @keyframes ring-pulse {\n    0% { transform: scale(1); opacity: .55; }\n    100% { transform: scale(1.9); opacity: 0; }\n  }\n  .ring-pulse { animation: ring-pulse 2.2s cubic-bezier(.22,1,.36,1) infinite; }\n\n  .gold-underline { position: relative; }\n  .gold-underline::after {\n    content: ''; position: absolute; left: 0; bottom: -3px; height: 1px; width: 100%;\n    background: #B49452; transform: scaleX(0); transform-origin: left;\n    transition: transform .5s cubic-bezier(.22,1,.36,1);\n  }\n  .gold-underline:hover::after { transform: scaleX(1); }\n\n  .benefit-row .benefit-line {\n    transition: width .6s cubic-bezier(.22,1,.36,1);\n  }\n  .benefit-row:hover .benefit-line { width: 100%; }\n\n  .input-line { border-bottom: 1px solid #E8E5DF; transition: border-color .35s ease; }\n  .input-line:focus-within { border-color: #B49452; }\n\n  /* allow the SP map label to render beyond the viewBox edge */\n  svg[viewBox=\"0 0 500 500\"] { overflow: visible; }\n</style>\n\n<div class=\"font-body bg-[#FBFAF8] text-[#0C0B09] antialiased\" style=\"font-feature-settings:'ss01','cv11';\" data-kid=\"1\">\n\n  \n  <div class=\"flex h-9 items-center justify-between bg-[#0C0B09] px-10 text-[10px] uppercase tracking-[0.22em] text-white/60\" data-kid=\"2\">\n    <span data-kid=\"3\">Curadoria de oportunidades Caixa e leilões · Vale do Paraíba</span>\n    <span class=\"flex items-center gap-2 text-[#D9C9A3]\" data-kid=\"4\">\n      <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" data-kid=\"5\"></svg>\n      Resposta em até 24h\n    </span>\n  </div>\n\n  \n  <header class=\"sticky top-0 z-50 border-b border-[#E8E5DF]/80 bg-white/75 backdrop-blur-xl\" data-kid=\"8\">\n    <div class=\"mx-auto flex h-[76px] max-w-[1280px] items-center justify-between px-10\" data-kid=\"9\">\n      <a href=\"#inicio\" class=\"flex items-baseline gap-2.5\" data-kid=\"10\">\n        <span class=\"font-display text-[26px] font-medium tracking-[-0.02em]\" data-kid=\"11\">Ícaro</span>\n        <span class=\"text-[10px] uppercase tracking-[0.32em] text-[#6B6A66]\" data-kid=\"12\">Imóveis</span>\n      </a>\n      <nav class=\"flex items-center gap-9\" data-kid=\"13\">\n        <a href=\"#inicio\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"14\">Início</a>\n        <a href=\"#sobre\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"15\">Sobre</a>\n        <a href=\"#imoveis\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"16\">Imóveis</a>\n        <a href=\"#oportunidades\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"17\">Oportunidades</a>\n        <a href=\"#beneficios\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"18\">Benefícios</a>\n        <a href=\"#contato\" class=\"gold-underline text-[13px] text-[#3A3A38] hover:text-[#0C0B09]\" style=\"transition: color .3s;\" data-kid=\"19\">Contato</a>\n      </nav>\n      <a href=\"https://wa.me/5512991968709\" target=\"_blank\" rel=\"noreferrer\" class=\"group inline-flex items-center gap-2.5 border border-[#0C0B09] bg-[#0C0B09] px-6 py-3 text-[11px] font-medium uppercase tracking-[0.18em] text-white hover:bg-transparent hover:text-[#0C0B09]\" style=\"transition: background-color .4s, color .4s;\" data-kid=\"20\">\n        Falar com Especialista\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" class=\"group-hover:translate-x-0.5\" style=\"transition: transform .4s;\" data-kid=\"21\"></svg>\n      </a>\n    </div>\n  </header>\n\n  \n  <section id=\"inicio\" class=\"hero-texture relative overflow-hidden\" data-kid=\"24\">\n    <div class=\"mx-auto grid min-h-[calc(100vh-112px)] max-w-[1280px] grid-cols-[1.16fr_0.84fr] gap-20 px-10 pb-24 pt-20\" data-kid=\"25\">\n      <div class=\"flex flex-col justify-center\" data-kid=\"26\">\n        <div data-reveal class=\"flex items-center gap-4 text-[11px] uppercase tracking-[0.3em] text-[#6B6A66]\" data-kid=\"27\">\n          <span class=\"grow-line h-px w-10 bg-[#B49452]\" style=\"transform-origin:left;\" data-kid=\"28\"></span>\n          Investimentos imobiliários · Vale do Paraíba\n        </div>\n        <h1 data-reveal class=\"font-display mt-9 text-[5.6rem] font-light leading-[0.99] tracking-[-0.03em] text-[#0C0B09]\" style=\"text-wrap:balance;\" data-kid=\"29\">\n          Invista em imóveis com <em class=\"font-normal italic text-[#8A7340]\" data-kid=\"30\">inteligência</em> e <em class=\"font-normal italic text-[#8A7340]\" data-kid=\"31\">segurança</em>.\n        </h1>\n        <p data-reveal class=\"mt-8 max-w-[540px] text-[17px] leading-[1.75] text-[#6B6A66]\" data-kid=\"32\">\n          Especialista em imóveis Caixa, oportunidades abaixo do valor de mercado e investimentos imobiliários no Vale do Paraíba.\n        </p>\n        <div data-reveal class=\"mt-11 flex items-center gap-4\" data-kid=\"33\">\n          <a href=\"#contato\" class=\"group inline-flex items-center gap-3 bg-[#0C0B09] px-8 py-[18px] text-[11px] font-medium uppercase tracking-[0.2em] text-white hover:-translate-y-0.5 hover:shadow-[0_24px_48px_-20px_rgba(12,11,9,0.45)]\" style=\"transition: transform .4s cubic-bezier(.22,1,.36,1), box-shadow .4s;\" data-kid=\"34\">\n            Quero receber oportunidades\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" class=\"group-hover:translate-x-1\" style=\"transition: transform .4s;\" data-kid=\"35\"></svg>\n          </a>\n          <a href=\"https://wa.me/5512991968709\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex items-center gap-2.5 border border-[#0C0B09]/25 px-8 py-[18px] text-[11px] font-medium uppercase tracking-[0.2em] text-[#0C0B09] hover:border-[#0C0B09] hover:bg-[#0C0B09] hover:text-white\" style=\"transition: background-color .4s, color .4s, border-color .4s;\" data-kid=\"38\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" data-kid=\"39\"></svg>\n            Falar no WhatsApp\n          </a>\n        </div>\n        <dl class=\"mt-16 grid grid-cols-3 divide-x divide-[#E8E5DF] border-t border-[#E8E5DF] pt-9\" data-kid=\"41\">\n          <div data-reveal class=\"pr-8\" data-kid=\"42\">\n            <dt class=\"font-display text-[52px] font-light leading-none tracking-[-0.02em]\" data-kid=\"43\">+<span class=\"counter\" data-target=\"10\" data-kid=\"44\">0</span></dt>\n            <dd class=\"mt-3 text-[10px] uppercase tracking-[0.22em] text-[#6B6A66]\" data-kid=\"45\">Cidades atendidas</dd>\n          </div>\n          <div data-reveal class=\"px-8\" data-kid=\"46\">\n            <dt class=\"font-display text-[52px] font-light leading-none tracking-[-0.02em]\" data-kid=\"47\"><span class=\"counter\" data-target=\"100\" data-kid=\"48\">0</span><span class=\"text-[#B49452]\" data-kid=\"49\">%</span></dt>\n            <dd class=\"mt-3 text-[10px] uppercase tracking-[0.22em] text-[#6B6A66]\" data-kid=\"50\">Análise consultiva</dd>\n          </div>\n          <div data-reveal class=\"px-8\" data-kid=\"51\">\n            <dt class=\"font-display text-[52px] font-light leading-none tracking-[-0.02em]\" data-kid=\"52\"><span class=\"counter\" data-target=\"24\" data-kid=\"53\">0</span><span class=\"text-[#B49452]\" data-kid=\"54\">h</span></dt>\n            <dd class=\"mt-3 text-[10px] uppercase tracking-[0.22em] text-[#6B6A66]\" data-kid=\"55\">Resposta ágil</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"relative flex items-center\" data-hero-photo data-kid=\"56\">\n        <div class=\"relative w-full border border-[#E8E5DF] bg-white p-3 shadow-[0_40px_80px_-48px_rgba(12,11,9,0.28)]\" data-kid=\"57\">\n          <div class=\"relative aspect-[4/5] overflow-hidden\" data-kid=\"58\">\n            <img src=\"/api/local/images/src/assets/%C3%8Dcaro_Foto_Perfil.jpeg\" alt=\"Ícaro — Especialista em Investimentos Imobiliários\" decoding=\"async\" class=\"h-full w-full object-cover object-top grayscale-[10%]\" data-parallax data-kid=\"59\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0C0B09]/45 via-transparent to-transparent\" data-kid=\"60\"></div>\n          </div>\n          \n          <div data-reveal class=\"absolute -right-5 top-10 flex items-center gap-2.5 border border-white/60 bg-white/70 px-5 py-3.5 shadow-[0_18px_40px_-20px_rgba(12,11,9,0.3)] backdrop-blur-md\" data-kid=\"61\">\n            <span class=\"grid h-7 w-7 place-items-center border border-[#B49452]/45 text-[#B49452]\" data-kid=\"62\">\n              <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" data-kid=\"63\"></svg>\n            </span>\n            <div data-kid=\"66\">\n              <div class=\"text-[9px] uppercase tracking-[0.24em] text-[#6B6A66]\" data-kid=\"67\">Especialista</div>\n              <div class=\"text-[12px] font-medium text-[#0C0B09]\" data-kid=\"68\">Imóveis Caixa</div>\n            </div>\n          </div>\n          \n          <div data-reveal class=\"absolute -bottom-8 -left-10 w-[270px] border border-white/60 bg-white/75 p-7 shadow-[0_30px_60px_-28px_rgba(12,11,9,0.35)] backdrop-blur-md\" data-kid=\"69\">\n            <div class=\"flex items-center gap-2 text-[10px] uppercase tracking-[0.28em] text-[#B49452]\" data-kid=\"70\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\" data-kid=\"71\"></svg>\n              Curadoria\n            </div>\n            <p class=\"font-display mt-3.5 text-[21px] font-light leading-[1.3] tracking-[-0.01em]\" data-kid=\"73\">Oportunidades antes do mercado.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"overflow-hidden border-y border-[#E8E5DF] bg-white py-5\" data-kid=\"74\">\n    <div class=\"marquee-track flex w-max items-center gap-12 whitespace-nowrap\" data-kid=\"75\">\n      <div class=\"flex items-center gap-12 text-[10px] uppercase tracking-[0.3em] text-[#6B6A66]\" data-kid=\"76\">\n        <span data-kid=\"77\">Imóveis Caixa</span><span class=\"text-[#B49452]\" data-kid=\"78\">✦</span>\n        <span data-kid=\"79\">Leilões Judiciais</span><span class=\"text-[#B49452]\" data-kid=\"80\">✦</span>\n        <span data-kid=\"81\">Venda Direta</span><span class=\"text-[#B49452]\" data-kid=\"82\">✦</span>\n        <span data-kid=\"83\">Licitações</span><span class=\"text-[#B49452]\" data-kid=\"84\">✦</span>\n        <span data-kid=\"85\">Análise de Investimento</span><span class=\"text-[#B49452]\" data-kid=\"86\">✦</span>\n        <span data-kid=\"87\">Abaixo do Valor de Mercado</span><span class=\"text-[#B49452]\" data-kid=\"88\">✦</span>\n      </div>\n      <div class=\"flex items-center gap-12 text-[10px] uppercase tracking-[0.3em] text-[#6B6A66]\" aria-hidden=\"true\" data-kid=\"89\">\n        <span data-kid=\"90\">Imóveis Caixa</span><span class=\"text-[#B49452]\" data-kid=\"91\">✦</span>\n        <span data-kid=\"92\">Leilões Judiciais</span><span class=\"text-[#B49452]\" data-kid=\"93\">✦</span>\n        <span data-kid=\"94\">Venda Direta</span><span class=\"text-[#B49452]\" data-kid=\"95\">✦</span>\n        <span data-kid=\"96\">Licitações</span><span class=\"text-[#B49452]\" data-kid=\"97\">✦</span>\n        <span data-kid=\"98\">Análise de Investimento</span><span class=\"text-[#B49452]\" data-kid=\"99\">✦</span>\n        <span data-kid=\"100\">Abaixo do Valor de Mercado</span><span class=\"text-[#B49452]\" data-kid=\"101\">✦</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <section id=\"sobre\" class=\"py-[150px]\" data-kid=\"102\">\n    <div class=\"mx-auto grid max-w-[1280px] grid-cols-[0.86fr_1.14fr] gap-24 px-10\" data-kid=\"103\">\n      <div data-reveal class=\"relative\" data-kid=\"104\">\n        <div class=\"absolute -left-5 -top-5 h-full w-full border border-[#B49452]/35\" data-kid=\"105\"></div>\n        <div class=\"relative overflow-hidden bg-[#F4F2ED]\" data-kid=\"106\">\n          <img src=\"/api/local/images/src/assets/%C3%8Dcaro_Corpo_inteiro2.jpeg\" alt=\"Ícaro — Especialista em Investimentos Imobiliários\" decoding=\"async\" loading=\"lazy\" class=\"aspect-[4/5] h-full w-full object-cover grayscale-[10%]\" data-parallax data-kid=\"107\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#0C0B09]/30 via-transparent to-transparent\" data-kid=\"108\"></div>\n        </div>\n      </div>\n      <div class=\"flex flex-col justify-center\" data-kid=\"109\">\n        <div data-reveal class=\"flex items-center justify-between\" data-kid=\"110\">\n          <div class=\"flex items-center gap-4 text-[11px] uppercase tracking-[0.3em] text-[#6B6A66]\" data-kid=\"111\">\n            <span class=\"grow-line h-px w-10 bg-[#B49452]\" style=\"transform-origin:left;\" data-kid=\"112\"></span> Sobre\n          </div>\n          <span class=\"font-display text-[44px] font-light leading-none text-[#E8E5DF]\" data-kid=\"113\">01</span>\n        </div>\n        <h2 data-reveal class=\"font-display mt-7 text-[56px] font-light leading-[1.08] tracking-[-0.025em]\" data-kid=\"114\">\n          Seu especialista em <em class=\"italic text-[#8A7340]\" data-kid=\"115\">investimentos</em> imobiliários.\n        </h2>\n        <p data-reveal class=\"mt-7 max-w-[560px] text-[16px] leading-[1.8] text-[#6B6A66]\" data-kid=\"116\">\n          Atuo auxiliando investidores e compradores a encontrar imóveis com alto potencial de valorização, oportunidades Caixa e imóveis de leilão — com foco em geração de patrimônio e rentabilidade.\n        </p>\n        <div data-reveal-group class=\"mt-11 grid grid-cols-2 gap-4\" data-kid=\"117\">\n          <div data-reveal class=\"group flex items-center gap-4 border border-[#E8E5DF] bg-white px-6 py-5 hover:border-[#B49452]/60\" style=\"transition: border-color .4s;\" data-kid=\"118\">\n            <span class=\"grid h-9 w-9 shrink-0 place-items-center border border-[#B49452]/40 text-[#B49452]\" data-kid=\"119\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"120\"></svg>\n            </span>\n            <span class=\"text-[14px] tracking-wide\" data-kid=\"122\">Imóveis abaixo do mercado</span>\n          </div>\n          <div data-reveal class=\"group flex items-center gap-4 border border-[#E8E5DF] bg-white px-6 py-5 hover:border-[#B49452]/60\" style=\"transition: border-color .4s;\" data-kid=\"123\">\n            <span class=\"grid h-9 w-9 shrink-0 place-items-center border border-[#B49452]/40 text-[#B49452]\" data-kid=\"124\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"no